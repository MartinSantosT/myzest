# Zest Recipe Manager — Environment variables
# Copy this file to .env and edit the values for your installation:
#
#   cp .env.example .env
#
# --- Secret key (JWT signing) ----------------------------------------------
#
# Generate a secure key with either:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
#
# If you leave ZEST_SECRET_KEY empty (or set to a known insecure default),
# Zest will generate a random key on first boot and persist it in
# data/.secret_key. The container will log a warning until you set the key
# explicitly. JWT tokens stay valid across restarts because the key is
# reused from that file.

ZEST_SECRET_KEY=

# --- Recipe scraper SSRF protection ----------------------------------------
#
# By default, the recipe scraper blocks any URL that resolves to a private
# IP range (10.x, 172.16.x, 192.168.x) plus loopback and cloud metadata
# endpoints. This prevents the scraper from being abused as a port scanner
# or proxy into your internal network.
#
# Set to "true" ONLY if you intentionally want to scrape recipes from
# another service running in your own LAN (e.g. an old Mealie or Tandoor
# instance, or a recipe blog you self-host). Loopback (127.x) and cloud
# metadata (169.254.x) remain blocked even when enabled.

ALLOW_PRIVATE_NETWORKS=false
