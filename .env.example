# Zest Recipe Manager — Environment variables
# Copy this file to .env and edit the values for your installation:
#
#   cp .env.example .env
#
# --- Secret key (JWT signing) ----------------------------------------------
#
# Zest signs every authentication token with this key. Anyone who knows
# the key can forge a valid token, so keep it secret and unique to your
# instance. Generate a fresh one with either of:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
#
# Paste the result as the value of ZEST_SECRET_KEY below. If you leave
# it empty (or set to a known insecure default like
# "zest-change-this-secret-in-production"), Zest generates a random key
# on first boot and persists it in data/.secret_key. The container will
# log a WARNING on every startup until you set the key explicitly.
# JWT tokens stay valid across restarts because the key is reused from
# that file.

ZEST_SECRET_KEY=

# --- Public registration ---------------------------------------------------
#
# Controls whether new users can register accounts after the first
# admin is created.
#
#   true  (default) — anyone who can reach this Zest URL can register
#                     a new account. Suitable for a family or a homelab
#                     on a closed/private network.
#
#   false           — only the very first user (admin) can register.
#                     New users must be invited (feature coming soon).
#                     Use this if you expose Zest to the public internet.
#
# The first user that registers always becomes admin regardless of this
# setting — initial setup is never blocked.

ALLOW_PUBLIC_REGISTRATION=true

# --- Recipe scraper SSRF protection ----------------------------------------
#
# By default, the recipe scraper blocks any URL that resolves to a private
# IP range (10.x, 172.16.x, 192.168.x) plus loopback and cloud metadata
# endpoints. This prevents the scraper from being abused as a port scanner
# or proxy into your internal network.
#
# Set to "true" ONLY if you intentionally want to scrape recipes from
# another service running in your own LAN (e.g. an old Mealie or Tandoor
# instance, or a recipe blog you self-host). Loopback (127.x) and cloud
# metadata (169.254.x) remain blocked even when enabled.

ALLOW_PRIVATE_NETWORKS=false
